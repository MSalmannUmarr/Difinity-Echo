# Local development infrastructure settings. DEVELOPMENT ONLY.
# scripts/bootstrap.sh copies this file to infra/local/.env (git-ignored) and
# replaces every __GENERATED__ value with a random local-only secret.
# Never reuse these values outside a developer machine.

# Host ports (bound to 127.0.0.1 only)
ECHO_KAFKA_HOST_PORT=59092
ECHO_CLICKHOUSE_HTTP_HOST_PORT=58123
ECHO_POSTGRES_HOST_PORT=55432
ECHO_OBJECT_STORAGE_HOST_PORT=59000
ECHO_OBJECT_STORAGE_CONSOLE_HOST_PORT=59001

# Development-only credentials (generated)
ECHO_CLICKHOUSE_USER=echo_local
ECHO_CLICKHOUSE_PASSWORD=__GENERATED__
ECHO_POSTGRES_USER=echo_local
ECHO_POSTGRES_PASSWORD=__GENERATED__
ECHO_OBJECT_STORAGE_ACCESS_KEY=echo-local
ECHO_OBJECT_STORAGE_SECRET_KEY=__GENERATED__
