{
  "name": "@difinity-echo/observability-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Typed health, readiness, correlation, operation-progress and safe failure-classification contracts shared by every Echo application.",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "generate": "generate-contract-types schemas src/generated",
    "generate:check": "generate-contract-types schemas src/generated --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@difinity-echo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
