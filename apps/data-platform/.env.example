DATA_PLATFORM_PORT=4100
DATA_PLATFORM_PROBE_TIMEOUT_MS=1500
DATA_PLATFORM_KAFKA_BOOTSTRAP=127.0.0.1:59092
DATA_PLATFORM_POSTGRES_ENDPOINT=127.0.0.1:55432
DATA_PLATFORM_CLICKHOUSE_URL=http://127.0.0.1:58123
DATA_PLATFORM_OBJECT_STORAGE_URL=http://127.0.0.1:59000
