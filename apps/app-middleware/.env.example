# Echo Application Middleware local configuration (development only, no secrets).
# Copied to .env by scripts/bootstrap.sh when absent. The middleware never
# receives database, Kafka or object-storage settings: it reaches data only
# through the tenant-aware Query API.
APP_MIDDLEWARE_HOST=127.0.0.1
APP_MIDDLEWARE_PORT=4000
APP_MIDDLEWARE_QUERY_API_URL=http://127.0.0.1:4100
APP_MIDDLEWARE_QUERY_API_TIMEOUT_MS=2000
